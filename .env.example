# Copy to .env.local and fill in with the values printed by `npm run db:start` (or `npx supabase status`).

# Public: safe in the browser. Row Level Security decides what each user can see.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret: server only (src/lib/supabase/admin.ts). Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
